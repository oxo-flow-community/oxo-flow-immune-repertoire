# tcga-mixcr.oxoflow — Phase 4: per-sample immune repertoire profiling.
# Lives at the PROJECT ROOT (oxo-flow resolves relative paths against this file).
#
# Per sample (sample domain from [workflow] metadata_file + [[sample_groups]]):
#   mixcr        : MiXCR rna-seq preset DIRECTLY on BAM (needs MI_LICENSE via
#                  shell_prelude). Chimeric BAM merged first when present.
#                  (GDC BAMs lack 0x40/0x80 READ1/READ2 flags, so a FASTQ
#                  intermediate via `samtools fastq` is NOT viable — MiXCR's
#                  own BAM reader pairs by QNAME instead. Verified 2026-11-14.)
#   trust4       : TRUST4 de novo directly on BAM(s) (independent branch, parallel)
#   standardize  : normalize both tools to the unified clonotype schema
#
# Long-term artifacts: .clones.tsv / .report.json / _cdr3.out / _report.tsv /
# .unified.tsv under results/{cancer}/{barcode_12}/{sample}/. Intermediates
# (.vdjca/.clna, merged tmp BAMs) live under tmp/ or the results sample dir.
#
# Gates: oxo-flow validate|dry-run|lint tcga-mixcr.oxoflow
# Run:   oxo-flow run tcga-mixcr.oxoflow -j 2 --provenance

[workflow]
name = "tcga-mixcr"
version = "0.1.0"
description = "TCGA RNA-seq TCR/BCR profiling with MiXCR + TRUST4"
author = "Shixiang Wang (wangshx@csu.edu.cn)"
# Shard variant: the sample domain comes from the per-shard manifests
# (one row per sample in metadata.tsv, one group in groups.tsv).
metadata_file = "manifests/metadata.tsv"
sample_groups_file = "manifests/groups.tsv"

# Sample-aware dispatch ties (oxo-flow >= 0.31.0, issue #1090). Default "rule"
# orders ready instances by name, which groups every `mixcr` of the chunk
# before the first `trust4` — a chunk of N samples produced its first unified
# result only after N/slots mixcr waves (~a week at chunk=100). With
# "sample", each sample runs its whole chain (mixcr -> trust4 -> standardize
# -> cleanup) before the next sample starts. A/B verified 2026-11-17 on a
# synthetic 4-sample x 2-rule workflow:
#   rule:   s1a s2a s3a s4a s1b s2b s3b s4b
#   sample: s1a s1b s2a s2b s3a s3b s4a s4b
[engine]
dispatch_order = "sample"

[defaults]
environment = { pixi = "pixi.toml" }
shell_prelude = "set -euo pipefail; [ -f $HOME/.config/tcga-mixcr/env ] && . $HOME/.config/tcga-mixcr/env || { echo 'license env missing'; exit 1; }"

# --- branch 1: MiXCR directly on BAM -------------------------------------

[[rules]]
name = "mixcr"
# 4 threads x 5 concurrent per node = 20 CPUs (the hard per-node policy).
# Measured 2026-11-16: MiXCR uses ~96% of its thread allocation, so 5 x
# 4-thread jobs fill ~19/20 cores vs 15.4 with 2 x 8-thread jobs.
# 64G, not 48G (2026-11-17): 17 GB OV BAMs aborted at ~6% alignment with
# -Xmx32g — MiXCR's own message suggested -Xmx40g, and the JVM heap must fit
# *together with* the merged/primary BAM page cache charged to the same
# cgroup (40G heap + ~17G cache < 64G). Same lesson as the LAML 32G crash
# (AGENTS.md §10): -Xmx must be 40g for full-size TCGA BAMs.
resources = { threads = 4, memory = "64G" }
priority = 30
description = "MiXCR rna-seq preset on the genomic BAM only (the chimeric BAM is a subset of it); primary alignments only"
output = [
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.clones.tsv",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.qc.json",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.readinfo.tsv",
  # COMPLETION SENTINEL, written as the last action. The cluster backend
  # treats "all declared outputs exist" as rule completion; a job killed
  # mid-run may already have written a partial clones.tsv/qc.json (T3d,
  # docs/oxoflow_issue_restart_silent_loss.md). With this sentinel the
  # existence test means "finished", not "started".
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.done",
]
log = "logs/{sample}.mixcr.log"
shell = """
mkdir -p results/{meta.cancer_type}/{meta.barcode_12}/{sample} tmp/{sample}/mixcr
# Project rule (AGENTS.md §1.3): TMPDIR MUST be under the project — /tmp is a
# 70G root partition and MiXCR's JVM temp on big samples fills it (live failure
# 2026-11-14: "No space left on device" on the 33G sample).
# WORKDIR-RELATIVE (not main-project absolute): shard workflows run under
# shards/shardN/ — an absolute main-project TMPDIR that is never mkdir'd
# crashes MiXCR with NoSuchFileException (Phase 5 first-pass failure,
# 2026-11-15). Create it, always.
# PER-RULE subdirectory: mixcr and trust4 of the SAME sample have no
# dependency edge, so they can run concurrently — a shared tmp/{sample} could
# have one rule delete the other's scratch. Each rule owns and removes its own.
export TMPDIR=$PWD/tmp/{sample}/mixcr
mkdir -p "$TMPDIR"
# The JVM under a cgroup sizes its default heap from the cgroup limit; give it
# an explicit, generous ceiling and keep java.io.tmpdir inside the project
# (a large sample spilled ~12 GB of temps in 5 minutes here).
# -Xmx MUST be an argument, not JAVA_TOOL_OPTIONS: the MiXCR launcher
# appends its own -Xmx (min(12g, free-memory cap)) whenever no -Xmx
# argument is present, and that later option overrides the env var.
# Observed 2026-11-17: every job really ran with 1.4-2.4 GB of heap
# ("This run used approximately 1394m" is Runtime.maxMemory).
export JAVA_TOOL_OPTIONS="-Djava.io.tmpdir=$TMPDIR -XX:-UsePerfData"
# GENOMIC BAM ONLY (2026-11-17, scientific review C1).
# [SRC:gdc-refs] [LOCAL-VERIFY: docs/scientific_rationale.md#7 C1] The GDC chimeric BAM
# is a strict subset of the genomic BAM — verified on 44f9e45d: 4,839 unique
# read names from chimera's first 5,000 records matched 9,741 genomic records
# (~2 per name, both mates), and MiXCR's own totalReadsProcessed equals
# (genomic primary + chimeric primary)/2 for a merged sample. Merging counted
# every chimeric read twice in 94.2% of the cohort, and the 642 samples
# without a chimeric BAM are exactly UCEC/COAD/READ — i.e. the bias was
# confounded with cancer type. Do NOT re-add the merge.
RAW_BAM={meta.bam_genomic}
# Primary-alignment-only filter (standard practice, Bolotin 2017 pipeline
# [SRC:samtools-spec 0x100/0x800] [SRC:bolotin2017]
# class): secondary (0x100)/supplementary (0x800) records are extra alignment
# records of the SAME physical read — keeping them could inflate clonotype
# counts. Whether MiXCR's BAM reader skips them internally is unverified, so
# we enforce it explicitly.
samtools view -@ {threads} -b -F 0x900 -o "$TMPDIR"/primary.bam $RAW_BAM
PREFIX=results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr
# Clean EVERYTHING this rule may have written before (reviews H9/M2): MiXCR
# appends to *report.txt/json, and a stale .clones_*.tsv would be merged into
# the new clones.tsv (17/39 old samples had concatenated, invalid report JSON
# and one had an empty-chain .clones_.tsv leak into TRA).
rm -f $PREFIX.done $PREFIX.clones.tsv $PREFIX.clones_*.tsv $PREFIX.clones_.tsv \
      $PREFIX.*.report.json $PREFIX.*.report.txt $PREFIX.qc.json \
      $PREFIX.alignments.vdjca $PREFIX.partial_assemblies.clna $PREFIX.contigs.clns
# read length / layout (review H2): TCGA mixes 76 bp single-end and 48 bp
# paired-end; both drive extraction efficiency, so record them per sample.
# `head -1` closes the pipe and samtools dies with SIGPIPE — under the
# workflow's `set -o pipefail` that made the whole pipeline "fail" and the
# fallback wrote NA for every sample (observed live 2026-11-17). Toggle
# pipefail around the capture instead of trusting the exit status.
set +o pipefail
FIRST_REC=$(samtools view -F 0x904 {meta.bam_genomic} 2>/dev/null | head -1)
set -o pipefail
{
  if [ -n "$FIRST_REC" ]; then
    printf '%s\n' "$FIRST_REC" | awk -v s={sample} 'BEGIN{OFS="\t"}{print s, length($10), (($2 % 2 == 1)?"paired-end":"single-end"), $2}'
  else
    printf '{sample}\tNA\tNA\tNA\n'
  fi
} > results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.readinfo.tsv
# [SRC:mixcr-presets] rna-seq preset REQUIRES --species and
# --assemble-longest-contigs (or --assemble-contigs-by); it is a preset
# requirement, not an optimisation. -Xmx must be an argument because the
# MiXCR launcher overrides JAVA_TOOL_OPTIONS.
# [LOCAL-VERIFY: docs/scientific_rationale.md#7 item 3 and 4]
mixcr -Xmx40g analyze rna-seq --species hsa --assemble-longest-contigs \
  --force-overwrite \
  -t {threads} \
  "$TMPDIR"/primary.bam \
  $PREFIX 2>&1 | tee -a logs/{sample}.mixcr.log
# MiXCR rna-seq exports one clones file PER CHAIN (<prefix>.clones_IGH.tsv,
# ..._TRA.tsv, ...). Merge them into the single declared <prefix>.clones.tsv
# with a chain column appended (variable per-sample chain sets cannot be
# declared as oxo-flow outputs; the merged file is the tracked artifact).
shopt -s nullglob
parts=( $PREFIX.clones_*.tsv )
if [ ${#parts[@]} -eq 0 ]; then
  # ZERO-CLONOTYPE SAMPLE (verified real: assemble report "Final clonotype
  # count: 0", 2026-11-15): a low-immune sample can yield no clones at all.
  # That is valid biology, not a failure — emit header-only tables so
  # downstream stages run and the sample records "no repertoire".
  echo "WARN: mixcr produced no per-chain clones exports (zero clonotypes) — writing empty tables"
  cp scripts/templates/mixcr_clones_header.tsv $PREFIX.clones.tsv
  [ -e $PREFIX.qc.json ] || echo '[]' > $PREFIX.qc.json
else
  { head -1 "${parts[0]}" | sed 's/$/\tchain/';
    for f in "${parts[@]}"; do
      ch=$(basename "$f" .tsv); ch=${ch##*.clones_}
      # an empty chain suffix means the clone could not be assigned to one
      # locus (chimeric/ambiguous V-J); it must not be silently filed under
      # whichever chain its V gene prefix suggests (review M2)
      [ -z "$ch" ] && ch="ambiguous"
      tail -n +2 "$f" | sed "s/$/\t$ch/"
    done; } > $PREFIX.clones.tsv
fi
# Sentinel records the parameters that define this generation (review H3):
# without them sample_metrics could not tell an 8-thread/32G pre-cutover file
# from a current 4-thread/40G one.
echo "mixcr-v2 genomic-only threads={threads} xmx=40g $(date -Is)" > $PREFIX.done
# Reclaim this rule's scratch immediately (10-20 GB/sample). The supervisor's
# two-stage sweep existed precisely because mixcr runs for every sample before
# any trust4 rule; under the cluster backend nothing else would clean this
# until standardize — i.e. tens of TB.
rm -rf "$TMPDIR"
"""

# --- branch 2: TRUST4 straight from BAM(s) (parallel to branch 1) -----------

[[rules]]
name = "trust4"
# 64G, not 24G (2026-11-19): TRUST4 builds a k-mer table whose size scales
# with the repertoire, and a 21.9 GB BAM with 54,335 MiXCR clones pushed it
# past the 24 GB cgroup ceiling — the kernel killed it at anon-rss 24.95 GB
# ("oom-kill:constraint=CONSTRAINT_MEMCG ... task=trust4", <node>, job 2040).
# Immune-rich samples are precisely the ones this project is about, so the
# ceiling must fit them; 64G matches the mixcr rule and leaves
# check_memory_budget.sh per-node arithmetic unchanged.
resources = { threads = 4, memory = "64G" }
# Priorities are GLOBAL, not per sample: a higher value on trust4 would run
# every trust4 before any mixcr (observed 2026-11-16: 20/20 slots on trust4,
# mixcr starved, no unified produced). The ladder below runs the long pole
# first and lets each sample's downstream stages jump ahead once ready.
priority = 20
description = "TRUST4 de novo repertoire reconstruction from the genomic BAM"
output = [
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4_cdr3.out",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4_report.tsv",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4_airr.tsv",
  # completion sentinel — see the mixcr rule
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4.done",
]
log = "logs/{sample}.trust4.log"
shell = """
mkdir -p results/{meta.cancer_type}/{meta.barcode_12}/{sample} tmp/{sample}/trust4
export TMPDIR=$PWD/tmp/{sample}/trust4
mkdir -p "$TMPDIR"
# Do NOT pass a second -b (2026-11-17, scientific review C1): run-trust4
# only reads $bamFiles[0] — the second -b was silently ignored all along, and
# the chimeric BAM is a subset of the genomic one anyway. One input, one
# meaning, same as the mixcr rule.
# [SRC:trust4-readme] -b is a single value; --repseq is only for targeted
# bulk non-UMI TCR/BCR-seq, so it is NOT used here (unselected RNA-seq).
# [LOCAL-VERIFY: docs/scientific_rationale.md#7 item 2]
EXTRA=""
P=results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4
rm -f $P.done
run-trust4 -b {meta.bam_genomic} $EXTRA \
  -f reference/trust4/hg38_bcrtcr.fa \
  --ref reference/trust4/human_IMGT+C.fa \
  -o $P \
  -t {threads} --clean 1 --abnormalUnmapFlag 2>&1 | tee -a logs/{sample}.trust4.log
# ZERO-CLONOTYPE SAMPLE tolerance (same rationale as the mixcr rule): TRUST4
# writes no AIRR file when nothing is assembled. Emit header-only outputs so
# the sample is recorded as "no repertoire" instead of failing the workflow.
for f in "$P"_cdr3.out "$P"_report.tsv "$P"_airr.tsv; do
  [ -s "$f" ] || { echo "WARN: trust4 produced no/empty $f — writing header-only stub"; }
done
[ -s "$P"_airr.tsv ] || cp scripts/templates/trust4_airr_header.tsv "$P"_airr.tsv
[ -s "$P"_cdr3.out ] || : > "$P"_cdr3.out
[ -s "$P"_report.tsv ] || : > "$P"_report.tsv
# TRUST4 leaves *_toassemble.fq / *_assembly.fa behind when a run is
# interrupted; at production scale (~100-200 MB each x 2,781 samples) they
# would silently fill results/. Declared outputs are kept.
rm -f "$P"_toassemble.fq "$P"_assembly.fa
echo "$(date -Is) ok" > $P.done
rm -rf "$TMPDIR"
"""

# --- join: unified clonotype table ---------------------------------------

[[rules]]
name = "standardize"
resources = { threads = 1, memory = "4G" }
priority = 40
target = true
description = "Normalize MiXCR clones.tsv + TRUST4 cdr3.out into the unified schema"
input = [
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.mixcr.clones.tsv",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.trust4_airr.tsv",
]
output = [
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.unified.tsv",
  "results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.unified.done",
]
log = "logs/{sample}.standardize.log"
# Dependencies are inferred from input/output templates: the engine links
# each instance of this rule to the SAME-SAMPLE producer. An explicit
# depends_on = ["mixcr", ...] expands to ALL instances of that rule and
# creates a group-wide barrier — one failed sample blocked 5,562 downstream
# rules in the 2026-11-16 canary (expand.rs:1053-1067). Do not re-add.
shell = "python scripts/standardize_clonotypes.py --mixcr {input[0]} --trust4-airr {input[1]} --barcode {meta.barcode_28} --cancer {meta.cancer_type} --output {output[0]} && echo \"$(date -Is) ok\" > {output[1]}"

# --- disk hygiene: reclaim per-sample scratch after the join ----------------

[[rules]]
name = "cleanup"
resources = { threads = 1, memory = "1G" }
priority = 50
target = true
description = "Delete per-sample scratch tmp/{sample} once the unified table is written (AGENTS.md §1.3a)"
input = ["results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.unified.tsv"]
output = ["results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.tmp_cleaned"]
log = "logs/{sample}.cleanup.log"
# Dependencies are inferred from input/output templates: the engine links
# each instance of this rule to the SAME-SAMPLE producer. An explicit
# depends_on = ["mixcr", ...] expands to ALL instances of that rule and
# creates a group-wide barrier — one failed sample blocked 5,562 downstream
# rules in the 2026-11-16 canary (expand.rs:1053-1067). Do not re-add.
shell = """
# Scratch (primary.bam / merged.bam) is 10-20 GB per sample; §1.3a requires
# every rule that materialises a big transient file to clean it up itself.
# Guard the target so an empty/unexpanded {sample} can never widen the rm.
# Integrity gate: never delete a sample's scratch unless its unified table
# carries the canonical header (a truncated file must not pass as complete).
head -1 results/{meta.cancer_type}/{meta.barcode_12}/{sample}/{meta.barcode_28}.unified.tsv \
  | grep -q '^barcode_28' || { echo "unified header missing — keeping scratch" >&2; exit 1; }
D=tmp/{sample}
case "$D" in
  tmp/?*) rm -rf "$D" ;;
  *) echo "refusing to delete unexpected path: $D" >&2; exit 1 ;;
esac
echo "$(date -Is) removed $D" > {output[0]}
"""
